# Configuración de entorno de la aplicación (Ejemplo - NUNCA colocar secretos reales aquí)
APP_ENV=development
POSTGRES_DB=tingo_reservas
POSTGRES_USER=reservas
POSTGRES_PASSWORD=reservas_local
# Para desarrollo local (usar puerto 5433 si se usa docker-compose)
DATABASE_URL=postgresql+psycopg://reservas:reservas_local@localhost:5433/tingo_reservas
# Para producción en EC2 / PostgreSQL gestionado, definir una cadena con credenciales seguras
# DATABASE_URL=postgresql+psycopg://usuario_prod:password_seguro@host_o_ip_privada:5432/tingo_reservas_prod
JWT_SECRET=change-me-in-development-32-chars!!
LOG_LEVEL=INFO
